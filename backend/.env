# =============================================================================
# Studious backend configuration.  Copy to  backend/.env  (never commit .env).
# In production (Render) set these as dashboard environment variables or as a
# Render Secret File named ".env" — real environment variables always win.
# Values containing spaces or JSON should be wrapped in single quotes.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=Studious
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
# Long random string used to sign download links. Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=s1t2u3d4i5o6u7s-m1e

# --- URLs / CORS -------------------------------------------------------------
# Public URL of the frontend (Netlify in production). Paystack sends customers back here.
FRONTEND_URL=https://studious-me.netlify.app
# Comma-separated origins allowed to call this API (scheme + host [+ port], no path)
ALLOWED_ORIGINS=https://studious-me.netlify.app
# Public URL of this API, used when building download links (optional locally)
API_URL=https://studious-s6km.onrender.com

# --- Database (created automatically on the first request) -------------------
DB_HOST=b6jooor8mtkqmemh2u0f-mysql.services.clever-cloud.com
DB_PORT=3306
DB_NAME=b6jooor8mtkqmemh2u0f
DB_USER=u674ww0m723si1tp
DB_PASS=QnJfnF97pIrIn4hV6hNu

# Clever Cloud: if you leave DB_* empty, MYSQL_ADDON_HOST / _PORT / _DB / _USER / _PASSWORD
# (injected by Clever Cloud) are used automatically. Otherwise copy them into DB_* above.
AUTO_SETUP=true
# Loads a demo university, departments and one sample question. Set false in production.
SEED_DEMO_DATA=true

# --- First administrator (created automatically if the email does not exist) --
ADMIN_NAME=Studious Admin
ADMIN_EMAIL=admin@studious.com
ADMIN_PASSWORD=12345678

# --- Auth ----------------------------------------------------------------------
TOKEN_TTL_DAYS=30

# --- Paystack (https://dashboard.paystack.com/#/settings/developers) --------------
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CURRENCY=NGN
# Optional override. Default: FRONTEND_URL + "/"  (the frontend then verifies the payment)
PAYSTACK_CALLBACK_URL=https://studious-me.netlify.app/

# --- File storage ----------------------------------------------------------------
# Local development stores files in backend/uploads. Production should use Google Drive
# (Render's disk is ephemeral). Paste the whole service-account JSON on ONE line, in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
MAX_UPLOAD_MB=20
